{
  "name": "dsh-session-relay",
  "version": "1.0.0",
  "description": "在可设置的模型回复阈值前压缩上下文，并开启新会话接力。",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "relay.js", "client.js", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE"],
  "scripts": {"test": "node --test test/*.test.js", "check": "node --check index.js && node --check relay.js && node --check client.js"},
  "dependencies": {"zod": "4.6.6"},
  "engines": {"node": ">=24", "dsh": ">=0.2.2-rc.5 <0.3.0"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
